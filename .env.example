# Copy to .env and fill in the two required values. .env is ignored by git.

# Required
ANTHROPIC_API_KEY=your-console-api-key
SEC_USER_AGENT=Your Name your@email.example

# Optional: defaults shown
# SEC_AGENT_DATA_DIR=~/.local/share/sec-agent
SEC_AGENT_MODEL_STRONG=claude-opus-5-5
SEC_AGENT_MODEL_WORKER=claude-haiku-5-5
SEC_AGENT_MAX_USD_PER_RUN=10
SEC_AGENT_LLM_CACHE=on

# Library settings
TOKENIZERS_PARALLELISM=false
ANONYMIZED_TELEMETRY=False
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# HF_HOME=/path/on/a/local/disk
